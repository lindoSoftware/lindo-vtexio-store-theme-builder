{
  "name": "store-theme-builder",
  "vendor": "lindo",
  "version": "0.0.1",
  "title": "Store Theme Builder",
  "description": "",
  "builders": {
    "node": "7.x",
    "graphql": "2.0"
  },
  "scripts": {
    "prereleasy": "bash lint.sh"
  },
  "credentialType": "absolute",
  "policies": [
    {
      "name": "outbound-access",
      "attrs": {
        "host": "ioadmin.lindo.la",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "api.github.com",
        "path": "*"
      }
    }
  ],
  "$schema": "https://raw.githubusercontent.com/vtex/node-vtex-api/master/gen/manifest.schema",
  "settingsSchema": {
    "title": "service settings",
    "type": "object",
    "properties": {
      "github_token": {
        "title": "GITHUB TOKEN",
        "description": "Enter your Github Token (ghp_aDNpnTl1G...)",
        "type": "string"
      }
    }
  }
}
