{
  "name": "vtexio-node-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "co-body": "^6.0.0",
    "ramda": "^0.26.1",
    "@octokit/rest": "^18.0.0"
  },
  "devDependencies": {
    "@types/co-body": "^0.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/ramda": "types/npm-ramda#dist",
    "@vtex/api": "^7.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "5.5.3"
  },
  "scripts": {
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.test.json"
      }
    },
    "roots": [
      "<rootDir>"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "verbose": true
  }
}
