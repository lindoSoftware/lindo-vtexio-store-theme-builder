{
  "memory": 256,
  "ttl": 10,
  "timeout": 60,
  "minReplicas": 2,
  "maxReplicas": 10,
  "workers": 4,
  "routes": {
    "deploy": {
      "path": "/_v/deploy",
      "public": true,
      "method": "POST"
    },
    "reconcile": {
      "path": "/_v/reconcile",
      "public": false,
      "method": "POST",
      "policies": [
        {
          "effect": "allow",
          "actions": ["post"],
          "principals": ["vrn:vtex.vtex-id:*:*:*:user/vtexappkey-lindoqa-*"]
        }
      ],
      "rateLimitPerReplica": {
        "concurrent": 1
      }
    }
  }
}
