{
  "memory": 256,
  "ttl": 10,
  "timeout": 60,
  "minReplicas": 2,
  "maxReplicas": 10,
  "workers": 4,
  "routes": {
    "deploy": {
      "path": "/_v/deploy",
      "public": true,
      "method": "POST"
    },
    "reconcile": {
      "path": "/_v/reconcile",
      "public": true,
      "method": "POST",
      "rateLimitPerReplica": {
        "concurrent": 1
      }
    }
  }
}
